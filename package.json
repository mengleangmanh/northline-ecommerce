{
  "name": "ecommerce-project",
  "version": "1.0.0",
  "private": true,
  "description": "Northline e-commerce - single Vercel project. Static React front end plus the Express API as one serverless function at /api.",
  "type": "module",
  "scripts": {
    "vercel-build": "cd ecommerce-frontend && npm install && npm run build",
    "dev:api": "cd ecommerce-backend && npm run dev",
    "dev:web": "cd ecommerce-frontend && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3"
  }
}
