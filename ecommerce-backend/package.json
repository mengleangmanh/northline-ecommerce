{
  "name": "ecommerce-backend",
  "version": "1.3.0",
  "description": "Express + Sequelize + MySQL API for the ecommerce project, with social sign-in, encrypted personal data and hardened HTTP",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed.js",
    "seed:fresh": "node seed.js --fresh",
    "keys": "node scripts/generate-keys.js",
    "encrypt:existing": "node scripts/encrypt-existing.js",
    "audit": "npm audit --omit=dev",
    "check:google": "node check-google-oauth.mjs",
    "check:db": "node test-db.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
