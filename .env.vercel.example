# ---------------------------------------------------------------------------
# Environment variables for the Vercel deployment (Railway MySQL)
#
# This file is a checklist, NOT a file you deploy. Vercel does not read .env
# from the repository. Paste each of these into:
#
#   Vercel dashboard -> your project -> Settings -> Environment Variables
#
# Set them for Production (and Preview, if you want previews to work).
# ---------------------------------------------------------------------------

NODE_ENV=production

# ---------------------------------------------------------------------------
# Your own domain. Both point at the SAME Vercel URL, because the front end and
# the API now live on one origin. CLIENT_URL drives the CORS allow-list;
# API_URL drives the CSP connect-src directive.
# ---------------------------------------------------------------------------
CLIENT_URL=https://your-app.vercel.app
API_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Railway MySQL
#
# In Railway: your MySQL service -> Variables tab. You need the PUBLIC values,
# not the internal ones - Vercel is outside Railway's private network.
#
#   Railway -> MySQL -> Settings -> Networking -> enable public networking.
#   That gives you a proxy host and a port. The port is NOT 3306.
#
# Railway's variables are named MYSQLHOST / MYSQLPORT / MYSQLUSER /
# MYSQLPASSWORD / MYSQLDATABASE. Map them onto ours below.
# ---------------------------------------------------------------------------
DB_HOST=switchback.proxy.rlwy.net
DB_PORT=10898
DB_NAME=railway

# NOT root. The production boot check in server.js refuses to start with
# DB_USER=root, on purpose. Create a limited user first by running
# database/06-create-app-user.sql against your Railway database.
DB_USER=root
DB_PASSWORD=nXlFCFTPkPdYBPPxHCStnTiuCcnmzvfC

# Encryption in transit. Railway's MySQL presents a self-signed certificate
# through its TCP proxy, so full verification fails. This combination encrypts
# the connection but does not verify the server's identity - better than plain
# text, weaker than a real CA. config/db.js prints a warning to remind you.
# If you want verified TLS, move the database to Aiven and use DB_SSL_CA.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Two per serverless container. config/db.js already defaults to this when
# VERCEL is set; setting it explicitly documents the intent.
DB_POOL_MAX=2

# Never true in production. The schema is applied by the SQL migrations, and
# the app user below has no ALTER grant anyway.
DB_SYNC_ALTER=false
SQL_LOG=false

# One proxy hop in front of the app (Vercel's edge), so req.ip is the real
# visitor and the rate limiter works per person rather than per planet.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Secrets. GENERATE FRESH ONES - do not reuse anything from your local .env,
# which has been on your laptop in plain text.
#
#   cd ecommerce-backend && npm run keys
#
# or, one at a time:  openssl rand -hex 32
#
# ENCRYPTION_KEY is the one that cannot be rotated casually: it decrypts the
# personal data already in the database. If you change it later, existing rows
# become unreadable. Set it once, then store it somewhere you will not lose it.
# ---------------------------------------------------------------------------
JWT_SECRET=Ja74kTgdT8ml0v2Qx5hmndw83aC3Xa1cBz0eSuX8CfCK53G5gE8tg8Gyr9VNPwxr
JWT_REFRESH_SECRET=SPgI7GA7--QlXFJL3TCFulsUDeipZiOgy7oFtr16E40
ENCRYPTION_KEY=7327aced54d1f85129720029b303900d5c20a5946fb66a3afc70a9eb934a2f61
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Social sign-in. Optional - leave all four unset and the app simply starts
# with social login disabled.
#
# Add these callback URLs in the Google and Facebook consoles:
#   https://your-app.vercel.app/api/auth/google/callback
#   https://your-app.vercel.app/api/auth/facebook/callback
#
# Preview deployments get their own random URLs, which will not match a
# registered callback, so social login only works on the production domain.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=254653986366-a5nurod5s1eequffp9nhruiff4obmlvr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------------------
# Deliberately NOT set: VITE_API_URL
#
# services/api.js falls back to '/api', which is now same-origin - so the
# browser calls the API on the very domain it was served from. No CORS
# preflight, no cross-site cookies, nothing to configure.
#
# Remember that every VITE_* variable is inlined into the JavaScript bundle at
# build time and is readable by anyone who opens devtools. Never put a secret
# behind a VITE_ prefix.
# ---------------------------------------------------------------------------
